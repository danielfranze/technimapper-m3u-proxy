{
    "$schema": "node_modules/knip/schema.json",
    "entry": ["frontend/main.ts", "scripts/*.js", "test/*.test.ts", "test-helpers/*.ts", "e2e/*.spec.ts", "e2e/*.ts"],
    "project": ["**/*.{ts,js}", "!dist/**", "!public/app/js/**", "!node_modules/**"],
    "ignore": ["**/*.d.ts", "frontend/generated/api.generated.d.ts"],
    "ignoreExportsUsedInFile": true,
    "ignoreDependencies": [],
    "rules": {
        "exports": "error",
        "types": "error",
        "duplicates": "error"
    }
}
