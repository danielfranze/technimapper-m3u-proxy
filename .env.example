# Example environment for local development. Copy to .env and adjust.
# Docker Compose sets DATA_DIR=/app/data; never commit .env or real credentials.

# PORT=9191
# DATA_DIR=./data
# REQUEST_TIMEOUT_MS=5000
# MAX_RESPONSE_BYTES=2097152
# SHUTDOWN_TIMEOUT_MS=30000

# ALLOW_NON_PRIVATE_IP=false
# ALLOW_LOOPBACK_RECEIVER=false

# ADMIN_USER=
# ADMIN_PASSWORD=
# TRUST_PROXY=
# HSTS=false

# HDHR_ENABLED=true
# HDHR_FRIENDLY_NAME=
# HDHR_DEVICE_ID=12345678
# HDHR_TUNER_COUNT=2

# LOG_LEVEL=info
# LOG_FORMAT=text
# TZ=Europe/Berlin
