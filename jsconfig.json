{
    "compilerOptions": {
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "checkJs": true,
        "strict": false,
        "noImplicitAny": false,
        "noEmit": true,
        "baseUrl": ".",
        "paths": {
            "lib/*": ["./lib/*"]
        }
    },
    "include": ["server.ts", "lib/**/*.ts"],
    "exclude": ["node_modules", "dist", "public"]
}