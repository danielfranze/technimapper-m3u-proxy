{
  "name": "technisat-mapper",
  "version": "2.0.0-rc.6",
  "description": "TechniSat IPTV Proxy",
  "type": "module",
  "main": "dist/server.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc -p tsconfig.json",
    "build:frontend": "tsc -p tsconfig.frontend.json",
    "start": "node dist/server.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "check:frontend": "tsc --noEmit -p tsconfig.frontend.json",
    "check:tests": "npx tsc --noEmit -p test && npx tsc --noEmit -p test-helpers",
    "test": "npm run build && node --import tsx --test",
    "coverage": "npm run build && node --import tsx scripts/coverage.js",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/xml2js": "^0.4.14",
    "fast-check": "^4.11.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "node-cron": "^4.6.0",
    "xml2js": "^0.6.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
