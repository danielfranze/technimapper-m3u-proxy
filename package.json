{
    "name": "technisat-mapper",
    "version": "2.0.0",
    "description": "TechniSat IPTV Proxy",
    "type": "module",
    "main": "dist/server.js",
    "private": true,
    "license": "MIT",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "build": "npm run clean && npm run build:backend && npm run build:frontend",
        "build:backend": "tsc -p tsconfig.json",
        "build:frontend": "npm run types:openapi && tsc -p tsconfig.frontend.json",
        "start": "node dist/server.js",
        "check": "tsc --noEmit -p tsconfig.json",
        "check:frontend": "tsc --noEmit -p tsconfig.frontend.json",
        "check:tests": "npx tsc --noEmit -p test && npx tsc --noEmit -p test-helpers",
        "test": "npm run build && node --import tsx --test",
        "coverage": "npm run build && node --import tsx scripts/coverage.js",
        "test:e2e": "npm run build && playwright test",
        "test:all": "npm test && npm run test:e2e",
        "types:openapi": "openapi-typescript docs/openapi.yaml -o frontend/generated/api.generated.d.ts",
        "lint": "npx biome check",
        "lint:fix": "npx biome check --fix",
        "format": "npx biome format --write",
        "format:check": "npx biome format",
        "knip": "npx knip",
        "clean": "node -e \"const fs=require('node:fs');for(const d of ['dist','public/app/js']){fs.rmSync(d,{recursive:true,force:true});}\""
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.9",
        "@playwright/test": "^1.52.0",
        "@types/compression": "^1.8.1",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.6",
        "@types/xml2js": "^0.4.14",
        "fast-check": "^4.11.0",
        "knip": "^6.48.0",
        "openapi-typescript": "^7.13.0",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "yaml": "^2.9.1"
    },
    "dependencies": {
        "compression": "^1.8.2",
        "express": "^5.3.0",
        "node-cron": "^4.6.0",
        "xml2js": "^0.6.2"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
